# Port to listen on
PORT=8080

# Database URL: PostgreSQL connection string or 'memory' for in-memory store
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xazavier?sslmode=disable

# JWT Secret: must be a strong random secret with at least 32 characters
JWT_SECRET=change-this-secret-key-to-at-least-32-characters

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookie security (set true in production when serving via HTTPS)
COOKIE_SECURE=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*

# Automatic database migrations on startup
AUTO_MIGRATE=true

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Trusted proxy IP / CIDR
TRUSTED_PROXY=

# Frontend Vite API URL (optional in dev if using Vite proxy)
VITE_API_URL=http://localhost:8080
