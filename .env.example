# Application
APP_ENV=development
PORT=8080

# Database
# Use "memory" for temporary in-memory development mode.
# Use a PostgreSQL connection string for persistent storage.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xazavier?sslmode=disable

# Docker PostgreSQL
POSTGRES_DB=xazavier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password

# Authentication
# Generate a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookie security
COOKIE_SECURE=false

# CORS – comma-separated list of trusted frontend origins (no trailing slash)
# In production, set to your deployed frontend domain e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database migrations
AUTO_MIGRATE=true

# Logging
LOG_LEVEL=info

# Trusted proxy IP / CIDR
TRUSTED_PROXY=

# Frontend API URL
# Empty/unset in development uses the mock API.
# Set to http://localhost:8080 to connect directly to Go API.
VITE_API_URL=

# Integration testing
# Use a dedicated test database, never production.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/xazavier_test?sslmode=disable